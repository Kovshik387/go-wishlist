# Режим. В production отключается dev-вход и обязательны HTTPS/секреты.
APP_ENV=development
APP_PORT=8080

# В production оба адреса должны быть HTTPS и указывать на один origin.
PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
DOMAIN=wish.example.com

# Сгенерируйте: openssl rand -base64 48
ACCESS_TOKEN_SECRET=change-me-at-least-32-random-characters

# Данные из @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=wishtrack_bot
TELEGRAM_APP_SHORT_NAME=app

# Сгенерируйте: openssl rand -hex 32. Передаётся Telegram при webhook setup.
TELEGRAM_WEBHOOK_SECRET=change-me-random-webhook-secret

# Брендинг доступен frontend через безопасный публичный config endpoint.
BRAND_NAME=WishTrack
BRAND_EMOJI=🎁
BRAND_PRIMARY=#2764ff
BRAND_ACCENT=#ff7c66

# Уведомления.
NOTIFICATION_DIGEST_WINDOW=5m
WORKER_POLL_INTERVAL=2s

# Обычно менять не нужно; внутри Docker заданы /app/data и /app/media.
DATABASE_PATH=./data/wishtrack.db
MEDIA_DIR=./media
MIGRATIONS_DIR=./migrations
WEB_DIR=./web/dist

# Только development: Telegram ID локального тестового пользователя.
DEV_TELEGRAM_ID=900000001
